# Copie para .env e preencha. Nunca versione o .env.

# Provedor de LLM (ADR 0005): gemini | ollama
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Modo offline (opcional)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Banco (padrões do docker-compose.yml)
DB_URL=jdbc:postgresql://localhost:5432/trilha
DB_USER=trilha
DB_PASSWORD=trilha
